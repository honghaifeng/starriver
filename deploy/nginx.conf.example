# Nginx 反向代理示例（不想用 Caddy 时）
# 位置：/etc/nginx/sites-available/star-river
# 生效：sudo ln -s ../sites-available/star-river /etc/nginx/sites-enabled/ && sudo nginx -t && sudo systemctl reload nginx
# 证书：certbot --nginx -d star.example.com

upstream star_river {
    server 127.0.0.1:7777;
    keepalive 16;
}

server {
    listen 80;
    listen [::]:80;
    server_name star.example.com;
    return 301 https://$host$request_uri;
}

server {
    listen 443 ssl http2;
    listen [::]:443 ssl http2;
    server_name star.example.com;

    ssl_certificate     /etc/letsencrypt/live/star.example.com/fullchain.pem;
    ssl_certificate_key /etc/letsencrypt/live/star.example.com/privkey.pem;
    ssl_protocols TLSv1.2 TLSv1.3;
    ssl_prefer_server_ciphers off;

    # 上传附件 / 参考图可能较大
    client_max_body_size 50m;

    add_header Strict-Transport-Security "max-age=31536000; includeSubDomains" always;
    add_header X-Content-Type-Options nosniff always;
    add_header X-Frame-Options SAMEORIGIN always;
    add_header Referrer-Policy strict-origin-when-cross-origin always;

    # SSE：/api/chat 必须关闭缓冲，否则流式失效
    location = /api/chat {
        proxy_pass http://star_river;
        proxy_http_version 1.1;
        proxy_set_header Host $host;
        proxy_set_header X-Real-IP $remote_addr;
        proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
        proxy_set_header X-Forwarded-Proto $scheme;
        proxy_set_header Connection '';
        proxy_buffering off;
        proxy_cache off;
        chunked_transfer_encoding on;
        proxy_read_timeout 600s;
        proxy_send_timeout 600s;
    }

    # 其余请求
    location / {
        proxy_pass http://star_river;
        proxy_http_version 1.1;
        proxy_set_header Host $host;
        proxy_set_header X-Real-IP $remote_addr;
        proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
        proxy_set_header X-Forwarded-Proto $scheme;
        proxy_read_timeout 120s;
    }
}
