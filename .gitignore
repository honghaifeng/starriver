# ============================================================
# 春科 · 星河 StarRiver —— 仓库忽略规则
#
# 一句话原则：**代码和文档进仓库，数据、密钥、运行产物一律不进。**
# 这个项目把「会话 / 资产 / 台账」全部落在 JSON 文件里，
# 一旦把这些文件提交上去，等于把客户名单和未公开文案公开到互联网。
# ============================================================

# ---------- 数据（真实业务内容，绝不入库） ----------
data/
data-demo/
sessions.json
*.db
*.sqlite
*.sqlite3

# 运行时落盘的东西（默认都在 data/ 下，这里再兜一层，防止有人改路径）
public/images/
public/videos/
public/uploads/
public/exports/

# ---------- 密钥与本地配置 ----------
config.json
.env
.env.*
!.env.example

# ---------- 生成物 ----------
report/
*.log
logs/
coverage/
dist/
build/

# ---------- 依赖 ----------
node_modules/
package-lock.json

# ---------- 系统 / 编辑器 ----------
.DS_Store
Thumbs.db
.idea/
.vscode/
*.swp
*~

# 备份产物
backups/

# 可选挂载的子站（品牌内容工作台，约 10MB，含第三方品牌资料，独立维护）
public/wb/
